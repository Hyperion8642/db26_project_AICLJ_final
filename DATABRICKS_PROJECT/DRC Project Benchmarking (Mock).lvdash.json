{
  "datasets": [
    {
      "name": "project_metrics",
      "displayName": "Project Metrics",
      "config": {
        "version": "1.1",
        "source": "workspace.default.cbpf_efficiency_final",
        "dimensions": [
          {
            "name": "Project Code",
            "expr": "project_code"
          },
          {
            "name": "Allocation Year",
            "expr": "allocation_year"
          },
          {
            "name": "Allocation Type",
            "expr": "allocation_source"
          },
          {
            "name": "Country",
            "expr": "country"
          },
          {
            "name": "Sector",
            "expr": "sector_tag"
          },
          {
            "name": "Efficiency Flag",
            "expr": "eff_flag"
          }
        ],
        "measures": [
          {
            "name": "Project Count",
            "expr": "COUNT(project_code)"
          },
          {
            "name": "Total Budget",
            "expr": "SUM(budget)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "People Targeted",
            "expr": "SUM(people_targeted)"
          },
          {
            "name": "Avg Budget per Person",
            "expr": "AVG(budget_per_person)"
          },
          {
            "name": "Flagged Projects",
            "expr": "SUM(CASE WHEN eff_flag IS NOT NULL THEN 1 ELSE 0 END)"
          },
          {
            "name": "Avg Efficiency Score",
            "expr": "AVG(eff_score)"
          },
          {
            "name": "Avg Severity",
            "expr": "AVG(severity)"
          }
        ]
      }
    },
    {
      "name": "flagged_projects",
      "displayName": "Flagged Projects",
      "queryLines": [
        "SELECT p.`project_code`, p.`project_title`, p.`country`, p.`allocation_year`, p.`allocation_source`, p.`sector_tag`, p.`budget`,\n",
        "p.`budget_per_person`, p.`sector_mean`, ROUND(p.`eff_score`, 2) AS `eff_score`, p.`eff_flag`,\n",
        "p.`sector_p10`, p.`sector_p90`, p.`people_targeted`, p.`severity`,\n",
        "u.`project_url`, u.`project_url_type`, c.`closest_1`, c.`closest_2`\n",
        "FROM workspace.default.cbpf_efficiency_final AS p\n",
        "LEFT JOIN read_files(\n",
        "  '/Workspace/Users/jcao2653@uw.edu/DATABRICKS_PROJECT/score_url.csv',\n",
        "  format => 'csv',\n",
        "  header => true\n",
        ") AS u\n",
        "ON p.`project_code` = u.`ChfProjectCode`\n",
        "LEFT JOIN workspace.default.cbpf_closest_projects AS c\n",
        "ON p.`project_code` = c.`project_code`\n",
        "WHERE p.`eff_flag` IS NOT NULL\n",
        "ORDER BY p.`allocation_year` DESC, p.`eff_score`"
      ]
    },
    {
      "name": "project_points",
      "displayName": "Project Points",
      "queryLines": [
        "SELECT `project_code`, `country`, `allocation_year`, `allocation_source`, `sector_tag`,\n",
        "`eff_flag`, `people_targeted`, `eff_score`\n",
        "FROM workspace.default.cbpf_efficiency_final"
      ]
    }
  ],
